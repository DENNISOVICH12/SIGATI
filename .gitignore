# ==========================================
# SIGATI - Archivos excluidos del repositorio
# ==========================================

# Laravel / Backend
backend/.env
backend/.env.*
!backend/.env.example
backend/vendor/
backend/storage/logs/*
backend/storage/framework/cache/*
backend/storage/framework/sessions/*
backend/storage/framework/views/*
backend/bootstrap/cache/*.php

# Vue / Frontend
frontend/.env
frontend/.env.*
!frontend/.env.example
frontend/node_modules/
frontend/dist/

# Dependencias accidentales en raíz
node_modules/
vendor/

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# IDE
.vscode/
.idea/

# Sistema operativo
.DS_Store
Thumbs.db
desktop.ini

# Temporales
*.tmp
*.temp
*.swp
*.bak

# Testing / coverage
coverage/
.phpunit.result.cache